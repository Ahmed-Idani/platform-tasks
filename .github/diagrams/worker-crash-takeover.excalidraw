   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "baseline": 81,
   "containerId": "e0WkW9cxxUEQ9ZDJfYqXP",
   "originalText": "Connection to A is gone: its message was never acked,\nso RabbitMQ redelivers it.",
