   "version": 1,
   "versionNonce": 0,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1790467809862,
   "link": null,
   "locked": false,
   "customData": null,
   "text": "Declared in infra/rabbitmq/definitions.json and loaded at broker boot.\nApps never declare: the API publishes to the exchange,\nthe worker only checks its queue exists (passive declare).",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 54,
   "containerId": null,
   "originalText": "Declared in infra/rabbitmq/definitions.json and loaded at broker boot.\nApps never declare: the API publishes to the exchange,\nthe worker only checks its queue exists (passive declare).",
   "lineHeight": 1.25
  },
