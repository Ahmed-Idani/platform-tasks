  },
  {
   "id": "DHlZFEoGanMfS-cHZq8d-",
   "type": "text",
   "x": 0,
   "y": 1260,
   "width": 549.9531860351562,
   "height": 60,
   "angle": 0,
   "strokeColor": "#1e1e1e",
