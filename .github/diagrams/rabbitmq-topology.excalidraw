   "customData": null,
   "text": "\u25c7 exchange (routes, stores nothing)     \u25ad queue (stores messages until acked)",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 14,
   "containerId": null,
   "originalText": "\u25c7 exchange (routes, stores nothing)     \u25ad queue (stores messages until acked)",
