   "link": null,
   "locked": false,
   "customData": null,
   "text": "\u2022 the model never runs again for a delivery problem\n\u2022 POST /v1/tasks/{id}/webhook/resend makes it due now\n\u2022 at-least-once: consumers dedupe on X-Task-Id\n\u2022 several API replicas can run the dispatcher safely",
   "fontSize": 20,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "baseline": 93,
   "containerId": null,
   "originalText": "\u2022 the model never runs again for a delivery problem\n\u2022 POST /v1/tasks/{id}/webhook/resend makes it due now\n\u2022 at-least-once: consumers dedupe on X-Task-Id\n\u2022 several API replicas can run the dispatcher safely",
   "lineHeight": 1.25
  },
