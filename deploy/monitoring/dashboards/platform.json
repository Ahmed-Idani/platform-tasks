    {
      "type": "timeseries",
      "title": "Queue depth",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "RabbitMQ per-queue depth. KEDA scales workers on 'waiting' (Stage 7).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(rabbitmq_detailed_queue_messages_ready{queue=\"tasks.llm_inference\"})",
          "legendFormat": "waiting",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(rabbitmq_detailed_queue_messages_unacked{queue=\"tasks.llm_inference\"})",
          "legendFormat": "running",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(rabbitmq_detailed_queue_messages_ready{queue=\"tasks.llm_inference.retry\"})",
          "legendFormat": "retry delay",
          "refId": "C"
