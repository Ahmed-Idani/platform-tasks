# Copy to secrets.env (gitignored) and adjust. Kustomize turns it into the Secret "platform-secrets".
POSTGRES_PASSWORD=admin
RABBITMQ_PASSWORD=admin
# Garage: access key id = GK + 24 hex chars, secret = 64 hex chars, rpc secret = 64 hex chars
S3_ACCESS_KEY_ID=GK706c6174666f726d2d746b73
S3_SECRET_ACCESS_KEY=6465762d6f6e6c792d73332d7365637265742d706c6174666f726d2d7461736b
GARAGE_RPC_SECRET=6465762d6f6e6c792d7270632d7365637265742d706c6174666f726d2d746b73
GARAGE_ADMIN_TOKEN=admin
# KEDA reads queue depth through the management API (vhost "/" = %2F); must match RABBITMQ_PASSWORD
KEDA_RABBITMQ_HOST=http://admin:admin@rabbitmq.platform:15672/rabbitmq/%2F
